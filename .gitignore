.gstack/

# /qa browser sweep output — screenshots and reports accumulate per run
.gstack/qa-reports/
test-results/

# Auto-generated by the preview tool; its values are wrong for this repo
# (npm/5173 instead of bun/8080) and it is per-developer anyway.
.claude/launch.json
supabase/functions/.env
.backups/

# CRM import payloads hold real client contact details (phones, emails). They
# are one-off inputs the scripts read from a local path, never from the repo;
# keep them out of source control (security audit 2026-10-07).
scripts/crm-import/*.json
scripts/crm-import/*.sql
