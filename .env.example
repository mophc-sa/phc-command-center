# Copy this file to .env.local (git-ignored) and fill in the real PHC AGENT
# publishable key for local development. Never commit real key values.
SUPABASE_PROJECT_ID="lrfdtoexyeghrzynapyn"
SUPABASE_PUBLISHABLE_KEY="<phc-agent-anon-publishable-key>"
SUPABASE_URL="https://lrfdtoexyeghrzynapyn.supabase.co"
VITE_SUPABASE_PROJECT_ID="lrfdtoexyeghrzynapyn"
VITE_SUPABASE_PUBLISHABLE_KEY="<phc-agent-anon-publishable-key>"
VITE_SUPABASE_URL="https://lrfdtoexyeghrzynapyn.supabase.co"

# Optional: override the error reporting endpoint (default: Supabase error-ingest function).
# Set to an Axiom dataset ingest URL, a custom webhook, etc.
# Leave blank to use the built-in Supabase endpoint (recommended).
# VITE_ERROR_REPORTING_ENDPOINT=""

# Cloudflare Turnstile site key (public, safe to expose client-side) for the
# CAPTCHA widget on sign-up/sign-in/password-reset. Create a Turnstile site
# at https://dash.cloudflare.com/?to=/:account/turnstile — the matching
# secret key is configured separately in Supabase Auth Dashboard →
# Authentication → Attack Protection, not here.
VITE_TURNSTILE_SITE_KEY=""
